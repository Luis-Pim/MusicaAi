rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && (request.auth.token.email_verified == true || exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile(request.auth.uid).get('accessMode', 'verified') == 'admin-test'); }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function active() { return signed() && profile(request.auth.uid).active == true; }
    function role() { return profile(request.auth.uid).role; }
    function staff() { return active() && role() in ['admin', 'encarregado']; }
    function teacher() { return active() && role() == 'instrutor'; }
    function canManage(d) {
      return active() && (role() == 'admin' || role() == 'encarregado' && d.role in ['instrutor','aluno'] || role() == 'instrutor' && d.role == 'aluno' && d.instructorId == request.auth.uid);
    }
    function canRead(d, uid) {
      return active() && (request.auth.uid == uid || staff() || teacher() && d.role == 'aluno' && d.instructorId == request.auth.uid);
    }
    function validAssignment(d) {
      return d.role != 'aluno' && d.instructorId == '' && d.groupId == '' || d.role == 'aluno' &&
        (d.instructorId == '' && d.groupId == '' ||
          profile(d.instructorId).role == 'instrutor' && profile(d.instructorId).active == true &&
          (d.groupId == '' || get(/databases/$(database)/documents/groups/$(d.groupId)).data.instructorId == d.instructorId));
    }
    function validProfile(d) {
      return d.keys().hasAll(['name','email','role','active','instructorId','groupId','createdAt']) &&
        d.keys().hasOnly(['name','email','role','active','instructorId','groupId','createdAt','accessMode','createdBy']) &&
        (!d.keys().hasAny(['accessMode','createdBy']) || d.accessMode == 'admin-test' && d.createdBy is string) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
        d.email is string && d.email.size() <= 254 && d.role in ['admin','encarregado','instrutor','aluno'] &&
        d.active is bool && d.instructorId is string && d.groupId is string && d.createdAt is timestamp;
    }
    function ownEmail(email) { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == email; }
    match /invites/{email} {
      allow get: if ownEmail(email) || staff() || teacher() && (!exists(/databases/$(database)/documents/invites/$(email)) || resource.data.role == 'aluno' && resource.data.instructorId == request.auth.uid);
      allow list: if staff() || teacher() && resource.data.role == 'aluno' && resource.data.instructorId == request.auth.uid;
      allow create: if canManage(request.resource.data) && validProfile(request.resource.data.profile) && validAssignment(request.resource.data.profile) &&
        request.resource.data.keys().hasOnly(['profile','role','instructorId','createdBy','createdAt','consumedBy']) &&
        request.resource.data.role == request.resource.data.profile.role &&
        request.resource.data.instructorId == request.resource.data.profile.instructorId &&
        !request.resource.data.profile.keys().hasAny(['accessMode','createdBy']) &&
        request.resource.data.profile.email == email && request.resource.data.profile.active == true &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.profile.createdAt == request.time && request.resource.data.consumedBy == '';
      // O convite não pode ser editado para promover um perfil. Cancele e crie outro.
      allow update: if ownEmail(email) && resource.data.consumedBy == '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedBy']) &&
        request.resource.data.consumedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data == resource.data.profile;
      allow delete: if canManage(resource.data);
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid &&
        (signed() || !exists(/databases/$(database)/documents/users/$(uid))) || canRead(resource.data, uid);
      allow list: if staff() || teacher() && resource.data.role == 'aluno' && resource.data.instructorId == request.auth.uid;
      allow create: if active() && role() == 'admin' && uid != request.auth.uid &&
        validProfile(request.resource.data) && validAssignment(request.resource.data) &&
        request.resource.data.accessMode == 'admin-test' && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.active == true && request.resource.data.createdAt == request.time;
      allow create: if ownEmail(request.resource.data.email) && request.auth.uid == uid && validProfile(request.resource.data) && validAssignment(request.resource.data) &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.consumedBy == '' &&
        request.resource.data == get(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.profile &&
        getAfter(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.consumedBy == uid;
      allow update: if canManage(resource.data) && canManage(request.resource.data) && uid != request.auth.uid &&
        validProfile(request.resource.data) &&
        (request.resource.data.instructorId == resource.data.instructorId && request.resource.data.groupId == resource.data.groupId || validAssignment(request.resource.data)) &&
        request.resource.data.get('accessMode', 'verified') == resource.data.get('accessMode', 'verified') &&
        request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.role == resource.data.role;
      // O perfil deve ser bloqueado antes da limpeza definitiva de dados no console.
      allow delete: if false;
      match /attempts/{attemptId} {
        allow read: if canRead(profile(uid), uid);
        allow create: if active() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['createdAt','payload']) &&
          request.resource.data.createdAt == request.time && request.resource.data.payload is string &&
          request.resource.data.payload.size() <= 200000;
        allow update, delete: if false;
      }
      match /feedback/{feedbackId} {
        allow read: if canRead(profile(uid), uid);
        allow create: if canRead(profile(uid), uid) && (staff() || teacher()) &&
          request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt']) &&
          request.resource.data.authorId == request.auth.uid && request.resource.data.authorName == profile(request.auth.uid).name &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /groups/{groupId} {
      allow get: if staff() || teacher() && resource.data.instructorId == request.auth.uid || active() && profile(request.auth.uid).groupId == groupId;
      allow list: if staff() || teacher() && resource.data.instructorId == request.auth.uid;
      allow create, update: if (staff() || teacher() && request.resource.data.instructorId == request.auth.uid) &&
        request.resource.data.keys().hasOnly(['name','instructorId','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        profile(request.resource.data.instructorId).role == 'instrutor' && profile(request.resource.data.instructorId).active == true &&
        (resource == null && request.resource.data.createdAt == request.time || resource != null &&
          request.resource.data.instructorId == resource.data.instructorId && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;
    }
  }
}
